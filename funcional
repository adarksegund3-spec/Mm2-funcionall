end

local function applyAlvoHighlight(target, cor)
    clearAlvoHighlight()
    if not target or not target.Character then return end
    local hl = Instance.new("Highlight")
    hl.Name = "AKZ_AlvoAtual"
    hl.Adornee = target.Character
