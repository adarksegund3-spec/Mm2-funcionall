local function AcharGunMaisProxima()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    if GunDrop.UltimaGun and GunDrop.UltimaGun.Parent then
        return GunDrop.UltimaGun
    end
    local myPos = hrp.Position
    local melhor, melhorDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if ehGun(obj) then
            local dist = (obj.Position - myPos).Magnitude
            if dist < melhorDist then
                melhorDist = dist
                melhor = obj
            end
        end
    end
    return melhor
end

local PegandoGun = false
local function PegarGun()
    if PegandoGun then return end
    local gun = AcharGunMaisProxima()
    if not gun then
        showToast("PEGAR GUN", "Nenhuma gun encontrada", DANGER_CLR)
        return
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    PegandoGun = true
    local origem = hrp.CFrame
    local destino = CFrame.new(gun.Position + Vector3.new(0, 2.5, 0))

    local function temGun()
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        for _, c in ipairs({char, bp}) do
            if c then
                for _, o in ipairs(c:GetChildren()) do
                    if o:IsA("Tool") and checkKeyword(o.Name, GUN_KEYWORDS) then return true end
                end
            end
        end
        return false
    end

    pcall(function() char:PivotTo(destino) end)
    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, gun, 0)
            firetouchinterest(hrp, gun, 1)
        end)
    end

    local t0 = tick()
    while tick() - t0 < 0.35 do
        if temGun() then break end
        pcall(function() char:PivotTo(destino) end)
        if firetouchinterest and gun.Parent then
            pcall(function()
                firetouchinterest(hrp, gun, 0)
                firetouchinterest(hrp, gun, 1)
            end)
        end
        RunService.Heartbeat:Wait()
    end

    pcall(function() char:PivotTo(origem) end)
    ZerarVelocidade(hrp)
    PegandoGun = false
    showToast("PEGAR GUN", temGun() and "Gun pega! Voltou pra onde estava" or "Voltou (gun não foi pega)", temGun() and SUCCESS_CLR or WARN_CLR)
end

