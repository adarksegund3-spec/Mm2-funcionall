-- Botão circular, arrastável por mouse/touch, distingue clique de arrasto,
-- com feedback visual e aparição/desaparição suave via TweenService.
local floatingButtons = {}

local function createFloatingButton(nome, icone, posicaoInicial, corBase)
    local btn = Instance.new("TextButton")
    btn.Name = "AKZ_Float_" .. nome
    btn.AnchorPoint = Vector2.new(0, 0)
    btn.Size = UDim2.new(0, 56, 0, 56)
    btn.Position = posicaoInicial
    btn.BackgroundColor3 = corBase
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = icone
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 22
    btn.TextColor3 = Color3.new(1,1,1)
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Visible = false
    btn.ZIndex = 50
    btn.Parent = screenGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.new(1,1,1)
    stroke.Thickness = 2
    stroke.Transparency = 0.35

    local shadow = Instance.new("Frame", btn)
    shadow.Size = UDim2.new(1, 6, 1, 6)
    shadow.Position = UDim2.new(0, -3, 0, -3)
    shadow.BackgroundColor3 = Color3.new(0,0,0)
    shadow.BackgroundTransparency = 0.7
    shadow.BorderSizePixel = 0
    shadow.ZIndex = -1

    local dragging   = false
    local dragStart, startPos
    local moved      = false
    local onClickFn  = nil

    local function pressDown()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            Size = UDim2.new(0, 50, 0, 50),
            BackgroundTransparency = 0.0,
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.1), {Transparency = 0}):Play()
    end

    local function pressUp()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 56, 0, 56),
            BackgroundTransparency = 0.15,
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.35}):Play()
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            moved     = false
            dragStart = input.Position
            startPos  = btn.Position
            pressDown()
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    pressUp()
                    if not moved and onClickFn then
                        task.spawn(onClickFn)
                    end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then moved = true end
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    local api = {
        btn = btn,
        stroke = stroke,
        SetOnClick = function(fn) onClickFn = fn end,
        Show = function()
            if btn.Visible then return end
            btn.Visible = true
            btn.Size = UDim2.new(0, 40, 0, 40)
            btn.BackgroundTransparency = 0.6
            TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 56, 0, 56),
                BackgroundTransparency = 0.15,
            }):Play()
        end,
        Hide = function()
            if not btn.Visible then return end
            local t = TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
            })
            t:Play()
            t.Completed:Connect(function()
                btn.Visible = false
                btn.Size = UDim2.new(0, 56, 0, 56)
                btn.BackgroundTransparency = 0.15
            end)
        end,
        SetCor = function(c)
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = c}):Play()
        end,
    }
    return api
end

