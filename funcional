-- Reutiliza getPlayerRole + GUN_KEYWORDS. Não teleporta, não move, não fling.
-- Para disparar, faz Tool:Activate() após alinhar a câmera com o Murderer.
-- Se no seu ambiente existirem remotes reais do MM2 para o disparo, cole-os em tryFireToolRemote().
local AutoShoot = { Ativo = false, Disparando = false, UltimoDisparo = 0 }

local function findMurderer()
    local melhor, melhorHum
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and getPlayerRole(p) == "Murderer" then
                return p, hum
            end
        end
    end
    return nil
end

local function getToolByKeyword(kw)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, c in ipairs({char, bp}) do
        if c then
            for _, o in ipairs(c:GetChildren()) do
                if o:IsA("Tool") and checkKeyword(o.Name, kw) then return o, char end
            end
        end
    end
    return nil, char
end

-- Gancho opcional: se você tiver remote de disparo, use aqui.
-- Ex.: local r = tool:FindFirstChildOfClass("RemoteEvent"); if r then r:FireServer(args) end
local function tryFireToolRemote(tool, alvoPart)
    -- Mantido intencionalmente vazio: o script não inventa remotes.
    -- Se MM2 tiver remote confirmado, adicione aqui.
    return false
end

local function atirarMurderer()
    if AutoShoot.Disparando then return end
    AutoShoot.Disparando = true

    task.spawn(function()
        local murderer, mHum = findMurderer()
        if not murderer then
            showToast("🔫 AUTO SHOOT", "Nenhum Murderer válido", DANGER_CLR)
            AutoShoot.Disparando = false
            return
        end

        local gun, char = getToolByKeyword(GUN_KEYWORDS)
        if not gun then
            showToast("🔫 AUTO SHOOT", "Sem arma (não é Sheriff)", DANGER_CLR)
            AutoShoot.Disparando = false
            return
        end

        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            AutoShoot.Disparando = false
            return
        end

        if gun.Parent ~= char then
            pcall(function() hum:EquipTool(gun) end)
            task.wait(0.06)
        end

        local mChar = murderer.Character
        if not mChar then AutoShoot.Disparando = false; return end
        local mHead  = mChar:FindFirstChild("Head")
                     or mChar:FindFirstChild("UpperTorso")
                     or mChar:FindFirstChild("Torso")
                     or mChar:FindFirstChild("HumanoidRootPart")
        if not mHead or (mHum and mHum.Health <= 0) then
            AutoShoot.Disparando = false
            return
        end

        local camPos = Camera.CFrame.Position
        local dir    = mHead.Position - camPos
        if dir.Magnitude > 0.01 then
            Camera.CFrame = CFrame.lookAt(camPos, camPos + dir.Unit)
        end

        -- Tenta remote (se um dia existir no script) e cai no Activate nativo.
        if not tryFireToolRemote(gun, mHead) then
            pcall(function() gun:Activate() end)
        end

        task.wait(0.05)
        AutoShoot.Disparando = false
        showToast("🔫 AUTO SHOOT", "Disparo em " .. murderer.DisplayName, SUCCESS_CLR)
    end)
end

