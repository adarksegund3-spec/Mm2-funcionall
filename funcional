local function Farm_MoverPara(destinoPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if hrp.Position.Y < FARM_VOID_Y then
        if Farm.PosInicial then
            pcall(function() char:PivotTo(Farm.PosInicial) end)
            task.wait(0.3)
            hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end
        end
    end
    if (destinoPos - hrp.Position).Magnitude > FARM_NEAR_DIST then
        local lv = Farm_GarantirVelocity(hrp)
        lv.Enabled = true
        local inicio = os.clock()
        while true do
            local c = LocalPlayer.Character
            if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then break end
            if not Farm.Ativo then break end
            if os.clock() - inicio > 10 then break end
            local cur = h.Position
            local diff = destinoPos - cur
            local dist = diff.Magnitude
            if dist <= FARM_NEAR_DIST then break end
            lv.VectorVelocity = diff.Unit * FARM_VELOCITY
            task.wait(0.05)
        end
        lv.VectorVelocity = Vector3.zero
        lv.Enabled = false
        task.wait(0.15)
        hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
    end
    local MAX_ITER = 12
    for i = 1, MAX_ITER do
        local c = LocalPlayer.Character
        if not c then return false end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return false end
        local hu = c:FindFirstChildOfClass("Humanoid")
        if not hu or hu.Health <= 0 then return false end
        local atual = h.Position
        local diff = destinoPos - atual
        local d = diff.Magnitude
        if d <= FARM_PIVOT_STEP then
            pcall(function() c:PivotTo(CFrame.new(destinoPos)) end)
            return true
        end
        local passo = diff.Unit * FARM_PIVOT_STEP
        pcall(function() c:PivotTo(CFrame.new(atual + passo)) end)
        task.wait(FARM_PIVOT_WAIT + math.random() * 0.03)
    end
    return false
end

local function Farm_ColetarMoeda(coin)
    if not coin or not coin.Parent then return false end
    if coin:GetAttribute("Collected") == true then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local destino = Vector3.new(
        coin.Position.X + (math.random() - 0.5) * 0.6,
        coin.Position.Y + 1,
        coin.Position.Z + (math.random() - 0.5) * 0.6
    )
    if not Farm_MoverPara(destino) then return false end
    task.wait(0.35)
    local destinoFinal = destino
    local pinConn = RunService.RenderStepped:Connect(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        h.CFrame = CFrame.new(destinoFinal)
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
    local partes = {"Head", "HumanoidRootPart", "LeftFoot", "RightFoot", "LeftLeg", "RightLeg"}
    local fim = os.clock() + FARM_VERIFY_TIMEOUT
    local coletou = false
    while os.clock() < fim do
        local c = LocalPlayer.Character
        if not c then break end
        if firetouchinterest then
            for _, nome in ipairs(partes) do
                local parte = c:FindFirstChild(nome)
                if parte then
                    pcall(function()
                        firetouchinterest(parte, coin, 0)
                        firetouchinterest(parte, coin, 1)
                    end)
                end
            end
        end
        if not coin or not coin.Parent then coletou = true; break end
        if coin:GetAttribute("Collected") == true then coletou = true; break end
        task.wait(0.08)
    end
    destinoFinal = Vector3.new(destinoFinal.X, coin.Position.Y + 4, destinoFinal.Z)
    task.wait(0.15)
    if pinConn then pinConn:Disconnect(); pinConn = nil end
    task.spawn(function()
        task.wait(0.4)
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if h.Position.Y < FARM_VOID_Y then
            if Farm.PosInicial then
                pcall(function() c:PivotTo(Farm.PosInicial) end)
            end
        end
    end)
    return coletou
end

local function Farm_Parar()
    Farm.Ativo = false
    Farm.Rodando = false
    if LocalPlayer.Character then Farm_LimparVelocity(LocalPlayer.Character) end
    Noclip_Stop(true)
end

local function Farm_Iniciar()
    if Farm.Rodando then return end
    Farm.Rodando = true
    Farm.Ativo = true
    Farm.Coletadas = 0
    Noclip_Start(true)
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then Farm.PosInicial = hrp.CFrame end
    end
    task.spawn(function()
        while Farm.Ativo do
            task.wait(0.5)
            local c = LocalPlayer.Character
            if c then
                local h = c:FindFirstChild("HumanoidRootPart")
                if h and h.Position.Y < FARM_VOID_Y then
                    if Farm.PosInicial then
                        pcall(function() c:PivotTo(Farm.PosInicial) end)
                    end
                    task.wait(0.5)
                end
            end
        end
    end)
    task.spawn(function()
        while Farm.Ativo do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hrp or not hum or hum.Health <= 0 then
                task.wait(0.5)
            else
                local moedas = Farm_ListarMoedas()
                if #moedas == 0 then
                    task.wait(1)
                    moedas = Farm_ListarMoedas()
                    if #moedas == 0 then
                        if Farm.PosInicial then
                            pcall(function() char:PivotTo(Farm.PosInicial) end)
                        end
                        Farm.Ativo = false
                        break
                    end
                else
                    local myPos = hrp.Position
                    table.sort(moedas, function(a, b)
                        return (a.Position - myPos).Magnitude < (b.Position - myPos).Magnitude
                    end)
                    for _, coin in ipairs(moedas) do
                        if not Farm.Ativo then break end
                        if coin and coin.Parent and coin:GetAttribute("Collected") ~= true then
                            if Farm_ColetarMoeda(coin) then
                                Farm.Coletadas = Farm.Coletadas + 1
                            end
                        end
                        task.wait(FARM_DELAY_ENTRE_MOEDAS)
                    end
                end
            end
            task.wait(0.1)
        end
        Farm.Rodando = false
        if LocalPlayer.Character then Farm_LimparVelocity(LocalPlayer.Character) end
        Noclip_Stop(true)
    end)
end

--═══════════════ FARM FÍSICO ═══════════════
local function FF_CleanupConns()
    if FarmFisico.HeartbeatConn then FarmFisico.HeartbeatConn:Disconnect(); FarmFisico.HeartbeatConn = nil end
    if FarmFisico.ConnAdded then FarmFisico.ConnAdded:Disconnect(); FarmFisico.ConnAdded = nil end
    if FarmFisico.ConnRemoved then FarmFisico.ConnRemoved:Disconnect(); FarmFisico.ConnRemoved = nil end
    if FarmFisico.ConnStarted then FarmFisico.ConnStarted:Disconnect(); FarmFisico.ConnStarted = nil end
    if FarmFisico.ConnCollected then FarmFisico.ConnCollected:Disconnect(); FarmFisico.ConnCollected = nil end
end

local function FF_StopMovement()
    if FarmFisico.LinearVelocity then
        FarmFisico.LinearVelocity.VectorVelocity = Vector3.zero
        FarmFisico.LinearVelocity.Enabled = false
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function FF_SetupVel()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    FarmFisico.Attachment = root:FindFirstChild("FarmAttachment")
    if not FarmFisico.Attachment then
        FarmFisico.Attachment = Instance.new("Attachment")
        FarmFisico.Attachment.Name = "FarmAttachment"
        FarmFisico.Attachment.Parent = root
    end
    FarmFisico.LinearVelocity = root:FindFirstChild("FarmLinearVelocity")
    if not FarmFisico.LinearVelocity then
        FarmFisico.LinearVelocity = Instance.new("LinearVelocity")
        FarmFisico.LinearVelocity.Name = "FarmLinearVelocity"
        FarmFisico.LinearVelocity.Attachment0 = FarmFisico.Attachment
        FarmFisico.LinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        FarmFisico.LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        FarmFisico.LinearVelocity.VectorVelocity = Vector3.zero
        FarmFisico.LinearVelocity.Enabled = false
        FarmFisico.LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        FarmFisico.LinearVelocity.MaxAxesForce = Vector3.new(100000, 100000, 100000)
        FarmFisico.LinearVelocity.Parent = root
    end
end

local function FF_RemoveVel()
    if FarmFisico.LinearVelocity then FarmFisico.LinearVelocity:Destroy(); FarmFisico.LinearVelocity = nil end
    if FarmFisico.Attachment then FarmFisico.Attachment:Destroy(); FarmFisico.Attachment = nil end
end

local function FF_IsCoin(part)
    if not part:IsA("BasePart") then return false end
    if FarmFisico.Blacklist[part] then return false end
    local n = part.Name:lower()
    return n:find("coin") or n:find("cash") or n:find("money") or n:find("collect")
end

local function FF_CheckBagFull()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "AKZ_Menu_MM2" and gui.Name ~= "AKZ_Toast" then
            local container = gui:FindFirstChild("Container", true)
            if container then
                for _, frame in ipairs(container:GetChildren()) do
                    if frame:IsA("Frame") and frame.Visible then
                        local fullIcon = frame:FindFirstChild("FullBagIcon", true)
                        local fullText = frame:FindFirstChild("Full", true)
                        if (fullIcon and fullIcon.Visible) or (fullText and fullText.Visible) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function FF_TriggerBagFullReset()
    if FarmFisico.BagFull then return end
    FarmFisico.BagFull = true
    FF_StopMovement()
    task.wait(0.2)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.Health = 0 end
    showToast("🎒 BOLSA CHEIA", "Resetando personagem", WARN_CLR)
end

local function FF_InitListeners()
    FarmFisico.ActiveCoins = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if FF_IsCoin(v) then FarmFisico.ActiveCoins[v] = true end
    end
    FarmFisico.ConnAdded = workspace.DescendantAdded:Connect(function(part)
        if FF_IsCoin(part) then FarmFisico.ActiveCoins[part] = true end
    end)
    FarmFisico.ConnRemoved = workspace.DescendantRemoving:Connect(function(part)
        FarmFisico.ActiveCoins[part] = nil
        if FarmFisico.CurrentTarget == part then FarmFisico.CurrentTarget = nil end
    end)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gameplay = remotes and remotes:FindFirstChild("Gameplay")
    if gameplay then
        local coinsStarted = gameplay:FindFirstChild("CoinsStarted")
        local coinCollected = gameplay:FindFirstChild("CoinCollected")
        if coinsStarted then
            FarmFisico.ConnStarted = coinsStarted.OnClientEvent:Connect(function()
                FarmFisico.WaitingForCoins = true
                FF_StopMovement()
                FarmFisico.CurrentTarget = nil
                FarmFisico.ActiveCoins = {}
                FarmFisico.Blacklist = {}
                FarmFisico.NoCoinsStart = nil
                FarmFisico.BagFull = false
                task.wait(FF.RoundStartDelay)
                for _, v in ipairs(workspace:GetDescendants()) do
                    if FF_IsCoin(v) then FarmFisico.ActiveCoins[v] = true end
                end
                FarmFisico.WaitingForCoins = false
            end)
        end
        if coinCollected then
            FarmFisico.ConnCollected = coinCollected.OnClientEvent:Connect(function(_, cur, mx)
                local c = tonumber(cur)
                local m = tonumber(mx)
                if c and m and c >= m then FF_TriggerBagFullReset() end
            end)
        end
    end
end

local function FF_StartTargetFinder()
    if FarmFisico.TargetFinderThr then task.cancel(FarmFisico.TargetFinderThr) end
    FarmFisico.TargetFinderThr = task.spawn(function()
        while FarmFisico.Loaded do
            task.wait(0.1)
            if FarmFisico.Ativo and not FarmFisico.BagFull and FF_CheckBagFull() then
                FF_TriggerBagFullReset()
            end
            if FarmFisico.Ativo and not FarmFisico.BagFull and not FarmFisico.WaitingForCoins then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local rootPos = root.Position
                    local nearest, nearestDist = nil, FF.MaxDist + 1
                    for coin in pairs(FarmFisico.ActiveCoins) do
                        if coin and coin.Parent and not FarmFisico.Blacklist[coin] then
                            local dist = (coin.Position - rootPos).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearest = coin
                            end
                        else
                            FarmFisico.ActiveCoins[coin] = nil
                        end
                    end
                    if nearest and not nearest:FindFirstChild("CoinVisual") then
                        FarmFisico.ActiveCoins[nearest] = nil
                        nearest = nil
                    end
                    FarmFisico.CurrentTarget = nearest
                end
            end
        end
    end)
end

local function FF_CheckStuck(root, targetPos, now)
    if not FarmFisico.LastPos then
        FarmFisico.LastPos = root.Position
        FarmFisico.StuckTime = now
        return
    end
    local moved = (root.Position - FarmFisico.LastPos).Magnitude
    if moved < 0.5 then
        if now - FarmFisico.StuckTime >= FF.StuckThreshold then
            local myPos = root.Position
            local dir = (targetPos - myPos)
            dir = Vector3.new(dir.X, 0, dir.Z)
            if dir.Magnitude > 0.1 then
                local step = dir.Unit * math.min(FF.UnstickStep, dir.Magnitude)
                local newPos = myPos + step + Vector3.new(0, 1, 0)
                pcall(function() LocalPlayer.Character:PivotTo(CFrame.new(newPos)) end)
            end
            FarmFisico.StuckTime = now
            FarmFisico.LastPos = root.Position
        end
    else
        FarmFisico.LastPos = root.Position
        FarmFisico.StuckTime = now
    end
end

local function FF_StartEngine()
    FF_CleanupConns()
    FF_SetupVel()
    FF_InitListeners()
    FarmFisico.NoCoinsStart = nil
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = os.clock()
    FarmFisico.HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not FarmFisico.Ativo or FarmFisico.BagFull or FarmFisico.WaitingForCoins then
            FF_StopMovement()
            return
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not root.Parent or not hum or hum.Health <= 0 then
            FF_StopMovement()
            return
        end
        if FarmFisico.CurrentTarget and FarmFisico.CurrentTarget.Parent
           and not FarmFisico.Blacklist[FarmFisico.CurrentTarget] then
            FarmFisico.NoCoinsStart = nil
            local targetPos = FarmFisico.CurrentTarget.Position
            local rootPos = root.Position
            local dist = (targetPos - rootPos).Magnitude
            if dist <= 2.0 then
                root.CFrame = CFrame.new(targetPos + Vector3.new(0, 1, 0))
                FF_StopMovement()
                FarmFisico.CollectedLife = true
                FarmFisico.Blacklist[FarmFisico.CurrentTarget] = true
                FarmFisico.ActiveCoins[FarmFisico.CurrentTarget] = nil
                FarmFisico.CurrentTarget = nil
                FarmFisico.Coletadas = FarmFisico.Coletadas + 1
                FarmFisico.LastPos = nil
            else
                FF_CheckStuck(root, targetPos, os.clock())
                if FarmFisico.LinearVelocity then
                    FarmFisico.LinearVelocity.Enabled = true
                    FarmFisico.LinearVelocity.VectorVelocity = (targetPos - rootPos).Unit * FF.TargetSpeed
                end
            end
        else
            FF_StopMovement()
            FarmFisico.LastPos = nil
            if FarmFisico.CollectedLife then
                if not FarmFisico.NoCoinsStart then
                    FarmFisico.NoCoinsStart = os.clock()
                elseif os.clock() - FarmFisico.NoCoinsStart >= FF.ResetDelay then
                    FarmFisico.NoCoinsStart = nil
                    FF_CleanupConns()
                    if hum.Health > 0 then hum.Health = 0 end
                end
            else
                FarmFisico.NoCoinsStart = nil
            end
        end
    end)
end

local function FarmFisico_Parar()
    FarmFisico.Ativo = false
    FarmFisico.Loaded = false
    FarmFisico.BagFull = false
    FarmFisico.WaitingForCoins = false
    FarmFisico.CollectedLife = false
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = 0
    FF_CleanupConns()
    FF_StopMovement()
    FF_RemoveVel()
    if FarmFisico.TargetFinderThr then
        task.cancel(FarmFisico.TargetFinderThr)
        FarmFisico.TargetFinderThr = nil
    end
    Noclip_Stop(true)
end

local function FarmFisico_Iniciar()
    FarmFisico.Ativo = true
    FarmFisico.Loaded = true
    FarmFisico.Coletadas = 0
    FarmFisico.BagFull = false
    FarmFisico.LastPos = nil
    FarmFisico.StuckTime = os.clock()
    Noclip_Start(true)
    FF_StartTargetFinder()
    FF_StartEngine()
    showToast("🌾 FARM FÍSICO", "Noclip ativado (não trava em paredes)", SUCCESS_CLR)
end

--═══════════════ GUN DROP ═══════════════
local GunDrop = GunDropConfig

local function ehGun(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("BasePart") then return false end
    local p = obj
    while p and p ~= workspace do
        if p:IsA("Model") and Players:GetPlayerFromCharacter(p) then return false end
        p = p.Parent
    end
    local match = checkKeyword(obj.Name, GUN_KEYWORDS)
    if not match then
        for _, c in ipairs(obj:GetChildren()) do
            if checkKeyword(c.Name, GUN_KEYWORDS) then match = true; break end
        end
    end
    if not match and obj.Parent then
        match = checkKeyword(obj.Parent.Name, GUN_KEYWORDS)
    end
    if not match then return false end
    return obj:FindFirstChildOfClass("TouchTransmitter") ~= nil
        or obj:FindFirstChild("TouchInterest") ~= nil
end

local GunDrop_CountLbl

local function GunDrop_Processar(obj)
    if not obj or not obj.Parent then return end
    if GunDrop.ObjetosVistos[obj] then return end
    if not ehGun(obj) then return end
    GunDrop.ObjetosVistos[obj] = true
    GunDrop.Total = GunDrop.Total + 1
    GunDrop.UltimaGun = obj
    GunDrop.ObjetosMonitorados[obj] = true
    local agora = tick()
    local debounce = (agora - GunDrop.UltimoAviso) < 1.5
    GunDrop.UltimoAviso = agora
    if GunDrop.ESPAtivo then
        if GunDrop.HighlightAtual then pcall(function() GunDrop.HighlightAtual:Destroy() end) end
        local hl = Instance.new("Highlight")
        hl.Name = "AKZ_GunDrop_HL"
        hl.Adornee = obj
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = WARN_CLR
        hl.OutlineColor = Color3.fromRGB(255, 240, 200)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Parent = obj
        GunDrop.HighlightAtual = hl
    end
    if GunDrop.AvisoDrop and not debounce then
        showToast("🔫 ARMA DROPADA", obj.Name .. " caiu no mapa!", WARN_CLR)
    end
    local conn
    conn = obj.Destroying:Connect(function()
        if GunDrop.HighlightAtual and GunDrop.HighlightAtual.Adornee == obj then
            pcall(function() GunDrop.HighlightAtual:Destroy() end)
            GunDrop.HighlightAtual = nil
        end
        if GunDrop.AvisoColeta and GunDrop.ObjetosMonitorados[obj] then
            showToast("📦 ARMA COLETADA", obj.Name .. " foi pega!", SUCCESS_CLR)
        end
        GunDrop.ObjetosMonitorados[obj] = nil
        if conn then conn:Disconnect() end
    end)
    if GunDrop_CountLbl and GunDrop_CountLbl.Parent then
        GunDrop_CountLbl.Text = "Detectadas: " .. GunDrop.Total
        GunDrop_CountLbl.TextColor3 = WARN_CLR
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if not GunDrop.ESPAtivo and not GunDrop.AvisoDrop
    and not GunDrop.AvisoColeta then return end
    task.wait(0.05)
    GunDrop_Processar(obj)
end)

local function GunDrop_VarrerAgora()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if ehGun(obj) then GunDrop_Processar(obj) end
    end
end

--═══════════════ AUTO KILL (FLING) — preservado ═══════════════
local FlingConfig = {
    Alvo        = "Sheriff",
    TempoMax    = 6,
    DelayVolta  = 4,
    Andando     = false,
    TouchAtivo  = false,
    AutoAtivo   = false,
    Cancelar    = false,
    AlvoAtual   = nil,
    MapaCache   = nil,
}

function FlingConfig.LimitesMapa()
    local container = Farm_PegarContainer()
    if not container then return nil end
    local raiz = container.Parent
    if not raiz or raiz == workspace then raiz = container end

    local c = FlingConfig.MapaCache
    if c and c.raiz == raiz and raiz.Parent then return c.min, c.max end

    local mn, mx
    for _, d in ipairs(raiz:GetDescendants()) do
        if d:IsA("BasePart") then
            local pos = d.Position
            if not mn then
                mn, mx = pos, pos
            else
                mn = Vector3.new(math.min(mn.X, pos.X), math.min(mn.Y, pos.Y), math.min(mn.Z, pos.Z))
                mx = Vector3.new(math.max(mx.X, pos.X), math.max(mx.Y, pos.Y), math.max(mx.Z, pos.Z))
            end
        end
    end
    if not mn then return nil end
    local margem = Vector3.new(80, 150, 80)
    mn, mx = mn - margem, mx + margem
    FlingConfig.MapaCache = { raiz = raiz, min = mn, max = mx }
    return mn, mx
end

function FlingConfig.EmPartida(role, pos, ancoras)
    if role == "Sheriff" or role == "Murderer" then return true end
    local mn, mx = FlingConfig.LimitesMapa()
    if mn then
        return pos.X >= mn.X and pos.X <= mx.X
           and pos.Y >= mn.Y and pos.Y <= mx.Y
           and pos.Z >= mn.Z and pos.Z <= mx.Z
    end
    for _, a in ipairs(ancoras) do
        if (a - pos).Magnitude <= 350 then return true end
    end
    return false
end

local function FlingListarAlvos()
    local ordem = { Sheriff = 1, Murderer = 2, Innocent = 3 }
    local candidatos, ancoras = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local role = getPlayerRole(p)
                table.insert(candidatos, { p = p, role = role, pos = r.Position })
                if role ~= "Innocent" then table.insert(ancoras, r.Position) end
            end
        end
    end

    local alvo = FlingConfig.Alvo
    local escolhidos = {}
    for _, c in ipairs(candidatos) do
        local ok = false
        if     alvo == "Todos"     then ok = true
        elseif alvo == "Sheriff"   then ok = (c.role == "Sheriff")
        elseif alvo == "Murder"    then ok = (c.role == "Murderer")
        elseif alvo == "Inocentes" then ok = (c.role == "Innocent") end
        if ok and FlingConfig.EmPartida(c.role, c.pos, ancoras) then
            table.insert(escolhidos, c)
        end
    end

    table.sort(escolhidos, function(x, y) return ordem[x.role] < ordem[y.role] end)

    local lista = {}
    for _, c in ipairs(escolhidos) do table.insert(lista, c.p) end
    return lista
end

local function FlingFoiLancado(tChar, tHum, tHRP, posInicial)
    if not tChar or not tChar.Parent then return true end
    if not tHRP or not tHRP.Parent then return true end
    if tHum and tHum.Health <= 0 then return true end
    if (tHRP.Position - posInicial).Magnitude > 250 then return true end
    if tHRP.AssemblyLinearVelocity.Magnitude > 2000 then return true end
    if tHRP.Position.Y < (workspace.FallenPartsDestroyHeight + 80) then return true end
    return false
end

local function ZerarVelocidade(hrp)
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function TouchEngine(ativoFn, pausarFn, pre)
    local mov = 0.1
    local ang = 0
    while ativoFn() do
        RunService.Heartbeat:Wait()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and not (pausarFn and pausarFn()) then
            if pre then pre() end
            local vel = hrp.AssemblyLinearVelocity
            local base = vel
            if pre and vel.Magnitude < 1 then
                ang = ang + 1.3
                base = Vector3.new(math.cos(ang) * 16, 0, math.sin(ang) * 16)
            end
            pcall(function()
                hrp.AssemblyLinearVelocity = base * 1e7 + Vector3.new(0, 1e7, 0)
            end)
            RunService.RenderStepped:Wait()
            if pre then pre() end
            pcall(function() hrp.AssemblyLinearVelocity = vel end)
            RunService.Stepped:Wait()
            if pre then pre() end
            pcall(function() hrp.AssemblyLinearVelocity = vel + Vector3.new(0, mov, 0) end)
            mov = -mov
        end
    end
end

local function FlingarAlvo(char, hrp, hum, alvo, origem)
    local tChar = alvo.Character
    local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local tHRP  = tHum and tHum.RootPart
    if not tChar or not tHum or not tHRP then return false end
    if tHum.Sit then return false end

    local posInicial = tHRP.Position
    local t0 = tick()
    local lancou = false
    local k, ang, mov = 0, 0, 0.1
    local offsets = {
        Vector3.new(0, 0, 0),   Vector3.new(0.8, 0, 0), Vector3.new(-0.8, 0, 0),
        Vector3.new(0, 0, 0.8), Vector3.new(0, 0, -0.8), Vector3.new(0, 0.8, 0),
    }

    local armado = (getPlayerRole(alvo) == "Murderer")
    local costas = {
        Vector3.new(0, 0, 0.9),    Vector3.new(0.2, 0.2, 0.85),
        Vector3.new(-0.2, -0.2, 0.85), Vector3.new(0, 0.3, 0.8),
    }

    local function colar()
        if not tHRP.Parent or not hrp.Parent then return end
        k = k + 1
        if armado then
            hrp.CFrame = tHRP.CFrame * CFrame.new(costas[(k % #costas) + 1])
        else
            hrp.CFrame = CFrame.new(tHRP.Position + offsets[(k % #offsets) + 1])
        end
    end

    local function voltarOrigem()
        for _ = 1, 3 do
            if not hrp.Parent then return end
            ZerarVelocidade(hrp)
            hrp.CFrame = origem
            pcall(function() char:PivotTo(origem) end)
            RunService.Heartbeat:Wait()
        end
        ZerarVelocidade(hrp)
    end

    local okLoop, errLoop = pcall(function()
        TouchEngine(function()
            if FlingConfig.Cancelar or not hrp.Parent or hum.Health <= 0 then return false end
            if (tick() - t0) > FlingConfig.TempoMax then return false end
            if FlingFoiLancado(tChar, tHum, tHRP, posInicial) then lancou = true; return false end
            return true
        end, nil, colar)
    end)
    if not okLoop then warn("[FLING] erro: " .. tostring(errLoop)) end

    voltarOrigem()
    return lancou
end

local function FlingCiclo(silencioso)
    if FlingConfig.Andando then return end

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = hum and hum.RootPart
    if not hrp or hum.Health <= 0 then
        if not silencioso then showToast("FLING", "Seu personagem está morto", DANGER_CLR) end
        return
    end

    local alvos = FlingListarAlvos()
    if #alvos == 0 then
        if not silencioso then showToast("FLING", "Nenhum alvo (" .. FlingConfig.Alvo .. ") vivo", DANGER_CLR) end
        return
    end

    FlingConfig.Andando = true
    FlingConfig.Cancelar = false
    local origem = hrp.CFrame
    if not silencioso then showToast("💥 FLING", FlingConfig.Alvo .. " • " .. #alvos .. " alvo(s)", WARN_CLR) end

    local okCiclo, errCiclo = pcall(function()
        for _, alvo in ipairs(alvos) do
            if FlingConfig.Cancelar or not hrp.Parent or hum.Health <= 0 then break end
            FlingConfig.AlvoAtual = alvo.DisplayName
            FlingarAlvo(char, hrp, hum, alvo, origem)
        end
    end)
    FlingConfig.AlvoAtual = nil
    if not okCiclo then
        warn("[FLING] erro: " .. tostring(errCiclo))
        showToast("FLING (erro)", tostring(errCiclo):sub(1, 70), DANGER_CLR)
    end

    pcall(function()
        if hrp.Parent and hum.Health > 0 then
            hrp.Anchored = false
            ZerarVelocidade(hrp)
            hrp.CFrame = origem
            pcall(function() char:PivotTo(origem) end)
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.PlatformStanding then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end)

    FlingConfig.Andando = false
    FlingConfig.Cancelar = false
end

local function AutoFling_Set(ativo)
    if ativo == FlingConfig.AutoAtivo then return end
    FlingConfig.AutoAtivo = ativo
    if not ativo then
        FlingConfig.Cancelar = true
        showToast("💥 AUTO KILL", "Desligado", DANGER_CLR)
        return
    end
    showToast("💥 AUTO KILL (FLING)", "Alvos: " .. FlingConfig.Alvo, SUCCESS_CLR)
    task.spawn(function()
        while FlingConfig.AutoAtivo do
            if #FlingListarAlvos() == 0 then
                task.wait(1)
            else
                FlingCiclo(true)
                task.wait(0.5)
            end
        end
    end)
end

